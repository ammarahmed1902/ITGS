# Production builds require the approved canonical HTTPS origin.
SITE_ENV=preview
SITE_URL=
# Both CMS values must be supplied together. Neither = approved empty Insights state.
SUPABASE_URL=
SUPABASE_ANON_KEY=
CMS_REQUIRED=false
# Approved public URLs only; no private keys. Optional until approved.
SOCIAL_IMAGE_URL=
SOCIAL_IMAGE_WIDTH=
SOCIAL_IMAGE_HEIGHT=
ANALYTICS_ENDPOINT=
ANALYTICS_PREVIEW=false
MONITORING_ENDPOINT=
PRIVACY_URL=
# Optional: the contact API can use a service-role key. Keep this server-side only.
# If omitted, apply the contact_submissions migration to allow anonymous inserts.
SUPABASE_SERVICE_ROLE_KEY=
